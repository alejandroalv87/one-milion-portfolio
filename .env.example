# ---------------------------------------------------------------------------
# This build uses Yahoo Finance, which needs NO API key. There is nothing you
# must set to run it. The only (optional) setting is below.
#
# Copy to ".env.local" for local dev, or set in your host (Netlify / Vercel).
# ---------------------------------------------------------------------------

# Seconds to cache each data response server-side (reduces calls to Yahoo while
# staying "live"). Default 60 if unset.
DATA_CACHE_TTL=60
