# ---------------------------------------------------------------------------
# Copy to ".env.local" for local dev, or set these in your host (Netlify / Vercel).
# Market data uses Yahoo Finance and needs NO key.
# ---------------------------------------------------------------------------

# Seconds to cache each data response server-side (default 60).
DATA_CACHE_TTL=60

# --- Optional access gate (single shared password) ---
# Leave BOTH of these blank to keep the site fully open (no login).
# Set BOTH to require a password before anyone can view the site.
#   - SITE_PASSWORD: the password you'll share with whoever may access it.
#   - AUTH_SECRET:   a long random string used to sign the login cookie.
#       generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SITE_PASSWORD=
AUTH_SECRET=

# How long a login lasts, in days (default 30).
SESSION_DAYS=30
